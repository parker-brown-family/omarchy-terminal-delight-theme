#!/usr/bin/env bash
# The gate. Dependency-free: bash + jq + python3 (for the MCP session), all of
# which the tools themselves already require. Hermetic: XDG_* point into a
# throwaway tree, every external command (hyprctl, omarchy-theme-*, glslang,
# terminal-delight) is a logging stub on PATH, and assertions read files and
# logs — never the live compositor.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(dirname "$here")"

T="$(mktemp -d)"
trap 'rm -rf "$T"' EXIT

export XDG_CONFIG_HOME="$T/config"
export XDG_STATE_HOME="$T/state"
export XDG_RUNTIME_DIR="$T/run"
# Two more roots since td-tint grew a second source: the palette home (XDG
# data) and Omarchy's own theme directory. Left unset they resolve to the real
# ones, and a suite that reads the developer's installed themes passes or
# fails on what happens to be on the box.
export XDG_DATA_HOME="$T/data"
export OMARCHY_PATH="$T/omarchy"
export TD_TEST_LOG="$T/log"
export TD_TEST_FIXTURES="$here/fixtures"
export PATH="$here/stubs:$root/bin:$PATH"

mkdir -p "$T/log" "$T/run" \
  "$XDG_CONFIG_HOME/omarchy/themes/terminal-delight-cherry" \
  "$XDG_CONFIG_HOME/omarchy/themes/terminal-delight-bat" \
  "$XDG_CONFIG_HOME/omarchy/themes/terminal-delight" \
  "$XDG_CONFIG_HOME/omarchy/themes/nord" \
  "$OMARCHY_PATH/themes/nord" \
  "$OMARCHY_PATH/themes/osaka-jade" \
  "$OMARCHY_PATH/themes/retro-82" \
  "$XDG_STATE_HOME/omarchy/current/theme"

# The second source: two shipped themes, one shipped-and-overridden name, and
# the ONE Terminal Delight the theme grid is supposed to carry. The generated
# `terminal-delight-<key>` directories beside it are palettes in the old
# shape and must never appear in this list.
cp "$here/fixtures/theme-colors.toml" "$XDG_CONFIG_HOME/omarchy/themes/terminal-delight/colors.toml"
printf 'accent = "#509475"\nbackground = "#111c18"\nforeground = "#C1C497"\nbright_cyan = "#8CD3CB"\n' \
  > "$OMARCHY_PATH/themes/osaka-jade/colors.toml"
printf 'accent = "#AA5500"\nbackground = "#100C08"\nforeground = "#D8C8B0"\n' \
  > "$OMARCHY_PATH/themes/retro-82/colors.toml"
printf 'accent = "#111111"\nbackground = "#000000"\nforeground = "#EEEEEE"\n' \
  > "$OMARCHY_PATH/themes/nord/colors.toml"
printf 'accent = "#88C0D0"\nbackground = "#2E3440"\nforeground = "#D8DEE9"\n' \
  > "$XDG_CONFIG_HOME/omarchy/themes/nord/colors.toml"

cp "$here/fixtures/variant-cherry.toml" "$XDG_CONFIG_HOME/omarchy/themes/terminal-delight-cherry/colors.toml"
printf '🍒\n' > "$XDG_CONFIG_HOME/omarchy/themes/terminal-delight-cherry/glyph"
cp "$here/fixtures/variant-cherry.toml" "$XDG_CONFIG_HOME/omarchy/themes/terminal-delight-bat/colors.toml"
printf '🦇\n' > "$XDG_CONFIG_HOME/omarchy/themes/terminal-delight-bat/glyph"
cp "$here/fixtures/theme-colors.toml" "$XDG_STATE_HOME/omarchy/current/theme/colors.toml"
printf 'terminal-delight\n' > "$XDG_STATE_HOME/omarchy/current/theme.name"
# The per-window warp, as install-curve.sh would have left it. Its presence is
# what td-tint reports as crt.available, and the marker is what distinguishes
# our shader from somebody else's file of the same name.
mkdir -p "$XDG_CONFIG_HOME/hypr/shaders"
printf '// terminal-delight per-window curved glass\n' \
  > "$XDG_CONFIG_HOME/hypr/shaders/surface.frag"
cp "$here/fixtures/monitor.frag" "$XDG_CONFIG_HOME/omarchy/themes/terminal-delight/crt-glass.frag"
cp "$here/fixtures/monitor.frag" "$XDG_CONFIG_HOME/omarchy/themes/terminal-delight-cherry/crt-glass.frag"
cp "$here/fixtures/monitor.frag" "$XDG_STATE_HOME/omarchy/current/theme/crt-glass.frag"

pass=0
fail=0
ok() { pass=$((pass + 1)); printf '  \033[32m✓\033[0m %s\n' "$1"; }
no() { fail=$((fail + 1)); printf '  \033[31m✗\033[0m %s\n' "$1"; }
assert_eq() { if [[ "$2" == "$3" ]]; then ok "$1"; else no "$1"; printf '      want %q\n      got  %q\n' "$3" "$2"; fi; }
assert_has() { if grep -qF -- "$3" <<<"$2"; then ok "$1"; else no "$1"; printf '      missing %q in:\n%s\n' "$3" "$2"; fi; }
assert_lacks() { if grep -qF -- "$3" <<<"$2"; then no "$1"; printf '      unexpected %q\n' "$3"; else ok "$1"; fi; }
hexch() { printf '%d' "0x${1:$2:2}"; }

echo "— colour math (sourced from bin/td-tint)"
# shellcheck source=/dev/null
source "$root/bin/td-tint"
# sourcing imported td-tint's `set -e`; a test runner must survive failing
# assertions, so switch it back off (pipefail/-u stay from our own set line)
set +e

assert_eq "dim_hex scales channels to 35%" "$(dim_hex F43C7A)" "55152A" 2>/dev/null || true
out="$(sat_hex 806060 2.0)"
assert_eq "sat_hex output is 6 hex chars" "${#out}" "6"
[[ "$out" != "806060" ]] && ok "sat_hex changes an unsaturated colour" || no "sat_hex changes an unsaturated colour"
r="$(hexch "$out" 0)"; g="$(hexch "$out" 2)"
[[ "$r" -gt "$g" ]] && ok "sat_hex keeps the red dominance" || no "sat_hex keeps the red dominance"
assert_eq "sat_hex is identity at full saturation" "$(sat_hex FF0000 1.6)" "FF0000"

out="$(phos_hex C0C0C0 22C55E)"
r="$(hexch "$out" 0)"; g="$(hexch "$out" 2)"; b="$(hexch "$out" 4)"
[[ "$g" -gt "$r" && "$g" -gt "$b" ]] && ok "phos_hex adopts the accent hue (green dominates)" || no "phos_hex adopts the accent hue"
avg=$(( (r + g + b) / 3 ))
[[ "$avg" -ge 120 && "$avg" -le 235 ]] && ok "phos_hex keeps the original lightness ballpark" || no "phos_hex keeps lightness (avg=$avg)"

echo "— saturate_toml"
saturate_toml "$here/fixtures/variant-cherry.toml" "$T/sat.toml" 1.6 "#F43C7A"
fg_line="$(grep '^foreground' "$T/sat.toml")"
assert_lacks "foreground was rewritten" "$fg_line" "C7A9B4"
fg_hex="$(sed -E 's/.*"#([0-9A-F]{6})".*/\1/' <<<"$fg_line")"
r="$(hexch "$fg_hex" 0)"; g="$(hexch "$fg_hex" 2)"
[[ "$r" -gt "$g" ]] && ok "foreground phosphor-ized toward cherry (red dominates)" || no "foreground phosphor-ized toward cherry"
assert_eq "background self-consistent with sat_hex" "$(grep '^background' "$T/sat.toml" | sed -E 's/.*"#([0-9A-F]{6})".*/\1/')" "$(sat_hex 0A0407 1.6)"
assert_eq "comment lines survive byte-identical" "$(head -1 "$T/sat.toml")" "# fixture: an installed variant palette"

echo "— the 256 colour cube (OSC 4 slots 16-231)"
cube="$(cube_osc 1.6)"
assert_eq "one OSC 4 sequence, not 216 of them" "$(grep -c $'\033]4;' <<<"$cube")" "1"
assert_eq "every cube slot is in it" "$(grep -o ';rgb:' <<<"$cube" | wc -l)" "216"
assert_has "it starts at 16" "$cube" ";16;rgb:"
assert_has "…and ends at 231" "$cube" ";231;rgb:"
assert_lacks "the base 16 stay the palette's job" "$cube" ";15;rgb:"
assert_lacks "the grey ramp is left alone (S=0, so the crank is identity)" "$cube" ";232;rgb:"
# Slot 180 is cube (4,3,2) = 215/175/135 = D7AF87 — the colour issue #7's own
# repro reaches for. Asserting it against sat_hex is what stops the awk in
# cube_osc drifting away from the awk in sat_hex.
slot180="$(sed -E 's/.*;180;rgb:(..)\/(..)\/(..).*/\1\2\3/' <<<"$cube")"
assert_eq "a cube slot agrees with sat_hex to the byte" "$slot180" "$(sat_hex D7AF87 1.6 | tr 'A-F' 'a-f')"
if [[ $slot180 != d7af87 ]]; then ok "…and cube-180 actually moved"; else no "cube-180 did not move"; fi

reset="$(cube_reset)"
assert_eq "the reset is one OSC 104" "$(grep -c $'\033]104;' <<<"$reset")" "1"
assert_has "it names the first cube slot" "$reset" ";16;"
assert_has "…and the last" "$reset" ";231"
assert_lacks "it never bare-resets, which would take the palette with it" "$reset" $'\033]104\033'

echo "— paint_tty: what actually lands on the tty"
paint_tty "$T/on.cap" "$here/fixtures/variant-cherry.toml" 1
on="$(cat "$T/on.cap")"
assert_has "on-path delivers a palette through omarchy-theme-osc" "$on" "OSC-FROM:"
assert_lacks "…a CRANKED one, not the variant file itself" "$on" "variant-cherry.toml"
assert_has "on-path carries the cube" "$on" ";180;rgb:"

paint_tty "$T/off.cap" "$here/fixtures/variant-cherry.toml" 0
off="$(cat "$T/off.cap")"
assert_has "off-path delivers the base palette verbatim" "$off" "variant-cherry.toml"
assert_has "off-path hands the cube back" "$off" $'\033]104;16;'
assert_lacks "…and cranks nothing" "$off" ";180;rgb:"

echo "— pick records"
rec="$T/run/td-tint-recdir-test"
rec_write "$rec" cherry 1
assert_eq "rec_variant round-trips" "$(rec_variant "$rec")" "cherry"
assert_eq "rec_sat reads sat=1" "$(rec_sat "$rec")" "1"
rec_write "$rec" "-" 0
assert_eq "no-variant records as dash" "$(rec_variant "$rec")" "-"
assert_eq "sat=0 writes no sat line" "$(rec_sat "$rec")" ""

echo "— resolving a pick to the palette that paints it"
assert_eq "a palette key resolves in the palette set" \
  "$(base_for cherry td)" "$XDG_CONFIG_HOME/omarchy/themes/terminal-delight-cherry/colors.toml"
assert_eq "a theme name resolves in Omarchy's set" \
  "$(base_for osaka-jade omarchy)" "$OMARCHY_PATH/themes/osaka-jade/colors.toml"
assert_eq "a user theme shadows the shipped one of the same name" \
  "$(base_for nord omarchy)" "$XDG_CONFIG_HOME/omarchy/themes/nord/colors.toml"
if base_for osaka-jade td >/dev/null 2>&1; then
  no "the two namespaces stay separate (a theme is not a palette)"
else
  ok "the two namespaces stay separate (a theme is not a palette)"
fi
if base_for nosuchthing omarchy >/dev/null 2>&1; then
  no "an unknown name fails instead of guessing a path"
else
  ok "an unknown name fails instead of guessing a path"
fi
assert_eq "theme_label title-cases a dashed name" "$(theme_label osaka-jade)" "Osaka Jade"
assert_eq "…and leaves digits alone" "$(theme_label retro-82)" "Retro 82"

echo "— the CRT switch resolves two different rounding questions"
assert_eq "the desktop's rounding is read live" "$(desktop_rounding)" "14"
assert_eq "…and is what a tile switched ON takes" "$(crt_rounding)" "14"
assert_eq "a square desktop still reports itself square" \
  "$(TD_TEST_ROUNDING=0 desktop_rounding)" "0"
assert_eq "…but a tile asking for the tube gets one anyway" \
  "$(TD_TEST_ROUNDING=0 crt_rounding)" "14"
if crt_available; then ok "the installed warp is detected"; else no "the installed warp is detected"; fi
mv "$XDG_CONFIG_HOME/hypr/shaders/surface.frag" "$T/shader.away"
if crt_available; then no "a missing warp is reported missing"; else ok "a missing warp is reported missing"; fi
printf 'not ours\n' > "$XDG_CONFIG_HOME/hypr/shaders/surface.frag"
if crt_available; then no "somebody else's surface.frag is not our warp"; else ok "somebody else's surface.frag is not our warp"; fi
mv "$T/shader.away" "$XDG_CONFIG_HOME/hypr/shaders/surface.frag"
assert_eq "the live desktop theme is read by name" "$(desktop_theme)" "terminal-delight"

echo "— records remember which list a pick came from"
srec="$T/run/td-tint-srcrec-test"
rec_write "$srec" osaka-jade 0 omarchy
assert_eq "an Omarchy pick records its source" "$(rec_src "$srec")" "omarchy"
rec_write "$srec" cherry 1
assert_eq "a palette pick records none, and reads as the palette set" "$(rec_src "$srec")" "td"
assert_eq "…without disturbing the crank" "$(rec_sat "$srec")" "1"
assert_eq "a record written before there were two sources reads as a palette" \
  "$(printf 'cherry\n' > "$srec"; rec_src "$srec")" "td"
rec_write "$srec" cherry 0 td off
assert_eq "an explicit CRT choice round-trips" "$(rec_crt "$srec")" "off"
rec_write "$srec" cherry 0 td on
assert_eq "…both ways" "$(rec_crt "$srec")" "on"
rec_write "$srec" cherry 0 td
assert_eq "no choice is not a choice — an untouched tile inherits the desktop" "$(rec_crt "$srec")" ""
assert_eq "…and 'inherit' is distinct from 'explicitly on', which --sync must re-pin" \
  "$(rec_write "$srec" cherry 0 td on; rec_crt "$srec")" "on"

echo "— td-tint --json"
json="$(bash "$root/bin/td-tint" --json)"
assert_eq "json lists both installed variants" "$(jq 'length' <<<"$json")" "2"
assert_eq "json carries the glyph" "$(jq -r '.[] | select(.key=="cherry") | .glyph' <<<"$json")" "🍒"
assert_eq "json carries accent" "$(jq -r '.[] | select(.key=="cherry") | .accent' <<<"$json")" "#F43C7A"
assert_has "json carries the partner colour" "$json" '"partner"'
assert_eq "a palette's label is its own key" "$(jq -r '.[] | select(.key=="cherry") | .label' <<<"$json")" "cherry"
assert_has "json carries the swatch background" "$json" '"bg"'
assert_has "json carries the swatch foreground" "$json" '"fg"'

echo "— td-tint --themes / --themes-json (the second source)"
tj="$(bash "$root/bin/td-tint" --themes-json)"
assert_eq "themes-json unions user and shipped themes, deduped by name" "$(jq 'length' <<<"$tj")" "4"
assert_eq "the ONE Terminal Delight is a theme, and stays one" \
  "$(jq '[.[] | select(.key == "terminal-delight")] | length' <<<"$tj")" "1"
assert_eq "the palettes are NOT themes — the grid carries one entry, not twelve" \
  "$(jq '[.[] | select(.key | startswith("terminal-delight-"))] | length' <<<"$tj")" "0"
assert_eq "a theme is labelled the way Omarchy's own picker names it" \
  "$(jq -r '.[] | select(.key=="osaka-jade") | .label' <<<"$tj")" "Osaka Jade"
assert_eq "a theme card carries no glyph — it is drawn as its own swatch" \
  "$(jq -r '.[] | select(.key=="osaka-jade") | .glyph' <<<"$tj")" ""
assert_eq "the swatch gets the theme's real colours" \
  "$(jq -r '.[] | select(.key=="osaka-jade") | [.accent, .bg, .fg] | @tsv' <<<"$tj")" \
  "$(printf '#509475\t#111c18\t#C1C497')"
assert_eq "a theme with no bright_cyan still gets a partner colour" \
  "$(jq -r '.[] | select(.key=="retro-82") | .partner' <<<"$tj")" "#AA5500"
assert_eq "the user's nord wins over the shipped one" \
  "$(jq -r '.[] | select(.key=="nord") | .accent' <<<"$tj")" "#88C0D0"
assert_has "--themes lists them by name" "$(bash "$root/bin/td-tint" --themes)" "osaka-jade"

echo "— td-tint --sync"
mkdir -p "$XDG_RUNTIME_DIR/td-tint"
printf 'cherry\n' > "$XDG_RUNTIME_DIR/td-tint/0xaaa"
printf 'ghost\n' > "$XDG_RUNTIME_DIR/td-tint/0xdead"
: > "$TD_TEST_LOG/hyprctl.log"
sync_out="$(bash "$root/bin/td-tint" --sync)"
assert_has "sync reports three paintable terminal windows" "$sync_out" "synced 3"
hlog="$(cat "$TD_TEST_LOG/hyprctl.log")"
assert_has "recorded window re-framed with its variant accent" "$hlog" 'active_border_color", value = "rgba(F43C7Aee)'
assert_has "recorded window's dim inactive set" "$hlog" '0xaaa'
assert_has "unrecorded window pinned to the theme accent" "$hlog" 'rgba(22C55Eee)'
assert_lacks "non-terminal (chrome) untouched" "$hlog" "0xccc"
assert_lacks "terminal-delight windows untouched" "$hlog" "0xddd"
[[ ! -f "$XDG_RUNTIME_DIR/td-tint/0xdead" ]] && ok "dead record swept" || no "dead record swept"
assert_eq "sync records its pin as '-' (stays reconcilable across theme switches)" "$(cat "$XDG_RUNTIME_DIR/td-tint/0xbbb")" "-"

echo "— record hygiene"
if bash "$root/bin/td-tint" --window 0xnope --saturate on >/dev/null 2>&1; then
  no "saturate on an unknown window refuses"
else
  ok "saturate on an unknown window refuses"
fi
[[ ! -e "$XDG_RUNTIME_DIR/td-tint/none" ]] && ok "no shared 'none' record is ever created" || no "no shared 'none' record is ever created"
[[ -x "$root/hooks/theme-set.d/td-tint-sync.hook" ]] && ok "theme-set hook shipped executable" || no "theme-set hook shipped executable"

echo "— td-tint --state (the oracle)"
state="$(bash "$root/bin/td-tint" --state)"
assert_eq "state sees the four terminal tiles, not chrome" "$(jq '.tiles | length' <<<"$state")" "4"
assert_eq "state carries the variant contract" "$(jq '.variants | length' <<<"$state")" "2"
assert_eq "…and the theme contract beside it" "$(jq '.themes | length' <<<"$state")" "4"
assert_eq "state names the theme the desktop is wearing right now" \
  "$(jq -r '.desktop_theme' <<<"$state")" "terminal-delight"
assert_eq "state reports the warp is installed, and what ON would round to" \
  "$(jq -c '[.crt.available, .crt.rounding]' <<<"$state")" "[true,14]"
assert_eq "a tile nobody switched inherits the desktop's tube" \
  "$(jq -r '.tiles[] | select(.address=="0xbbb") | .crt' <<<"$state")" "true"
assert_eq "a tile reports which list its pick came from" \
  "$(jq -r '.tiles[] | select(.address=="0xaaa") | .source' <<<"$state")" "td"
assert_eq "state names the active workspace" "$(jq '.active_workspace' <<<"$state")" "1"
assert_eq "state carries the focused window" "$(jq -r '.focused' <<<"$state")" "0xbbb"
assert_eq "state carries the monitor offset" "$(jq -c '[.monitor.x, .monitor.y]' <<<"$state")" "[0,0]"
assert_eq "recorded pick surfaces on its tile" "$(jq -r '.tiles[] | select(.address=="0xaaa") | .variant' <<<"$state")" "cherry"
assert_eq "a '-' pin surfaces as null variant" "$(jq -r '.tiles[] | select(.address=="0xbbb") | .variant' <<<"$state")" "null"
assert_eq "terminal-delight tiles are flagged unpaintable" "$(jq -c '.tiles[] | select(.address=="0xddd") | [.terminal_delight, .paintable]' <<<"$state")" "[true,false]"
assert_eq "Omarchy's generic agent terminal is paintable" "$(jq -c '.tiles[] | select(.address=="0xeee") | [.class, .terminal_delight, .paintable]' <<<"$state")" '["org.omarchy.agent",false,true]'
assert_eq "tiles carry pid and geometry for the overlay" "$(jq -c '.tiles[] | select(.address=="0xaaa") | [.pid, .at, .size]' <<<"$state")" "[100,[0,0],[400,300]]"

echo "— td-monitor"
listing="$(bash "$root/bin/td-monitor" list)"
assert_has "list shows ANIMATED" "$listing" "ANIMATED = 0"
assert_has "list shows a float knob" "$listing" "SCAN = 0.22"
bash "$root/bin/td-monitor" set SCAN 0.5 >/dev/null
assert_has "set rewrites the staged copy" "$(grep '^const float SCAN' "$XDG_STATE_HOME/omarchy/current/theme/crt-glass.frag")" "0.5;"
assert_has "set rewrites the whole family" "$(grep '^const float SCAN' "$XDG_CONFIG_HOME/omarchy/themes/terminal-delight-cherry/crt-glass.frag")" "0.5;"
[[ -s "$TD_TEST_LOG/glslang.log" ]] && ok "edits validated before applying" || no "edits validated before applying"
bash "$root/bin/td-monitor" set TRACKING 0.7 >/dev/null
assert_has "a motion knob auto-raises ANIMATED" "$(grep '^#define ANIMATED' "$XDG_STATE_HOME/omarchy/current/theme/crt-glass.frag")" "ANIMATED 1"
bash "$root/bin/td-monitor" set TRACKING 0 FLICKER 0 JIGGLE 0 >/dev/null
assert_has "all motion at zero auto-drops ANIMATED" "$(grep '^#define ANIMATED' "$XDG_STATE_HOME/omarchy/current/theme/crt-glass.frag")" "ANIMATED 0"
if bash "$root/bin/td-monitor" set NOPE 1 >/dev/null 2>&1; then no "unknown knob refused"; else ok "unknown knob refused"; fi
if bash "$root/bin/td-monitor" set SCAN abc >/dev/null 2>&1; then no "non-number refused"; else ok "non-number refused"; fi

echo "— td-mcp (scripted stdio session)"
mcp_out="$(printf '%s\n' \
  '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}' \
  '{"jsonrpc":"2.0","method":"notifications/initialized"}' \
  '{"jsonrpc":"2.0","id":2,"method":"ping"}' \
  '{"jsonrpc":"2.0","id":3,"method":"tools/list"}' \
  '{"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"list_variants","arguments":{}}}' \
  '{"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"border_only","arguments":{"address":"0xaaa","variant":"cherry"}}}' \
  '{"jsonrpc":"2.0","id":6,"method":"tools/call","params":{"name":"monitor_set","arguments":{"knob":"GLARE","value":0.3}}}' \
  '{"jsonrpc":"2.0","id":7,"method":"tools/call","params":{"name":"list_tiles","arguments":{}}}' \
  '{"jsonrpc":"2.0","id":8,"method":"tools/call","params":{"name":"nope","arguments":{}}}' \
  '{"jsonrpc":"2.0","id":9,"method":"tools/call","params":{"name":"state","arguments":{}}}' \
  '{"jsonrpc":"2.0","id":10,"method":"tools/call","params":{"name":"list_themes","arguments":{}}}' \
  '{"jsonrpc":"2.0","id":11,"method":"tools/call","params":{"name":"crt","arguments":{"address":"0xbbb","mode":"off"}}}' \
  | python3 "$root/bin/td-mcp")"
line() { sed -n "${1}p" <<<"$mcp_out"; }
assert_eq "initialize answers the protocol version" "$(line 1 | jq -r .result.protocolVersion)" "2024-11-05"
assert_eq "server names itself" "$(line 1 | jq -r .result.serverInfo.name)" "td-paint"
assert_eq "ping pongs (empty result, no error)" "$(line 2 | jq -c .result)" "{}"
assert_eq "tools/list advertises the full surface" "$(line 3 | jq '.result.tools | length >= 13')" "true"
assert_has "…including the second source" "$(line 3 | jq -r '.result.tools[].name' | tr '\n' ' ')" "paint_theme"
assert_has "…and the tube" "$(line 3 | jq -r '.result.tools[].name' | tr '\n' ' ')" "crt"
assert_has "tools/list includes paint" "$(line 3 | jq -r '.result.tools[].name' | tr '\n' ' ')" "paint"
assert_eq "every tool ships a description and schema" "$(line 3 | jq '(.result.tools | length) as $n | [.result.tools[] | select((.description | length) > 0 and .inputSchema.type == "object")] | length == $n')" "true"
assert_eq "list_variants returns parseable variants" "$(line 4 | jq -r '.result.content[0].text' | jq 'length')" "2"
assert_has "border_only paints through the CLI" "$(line 5 | jq -r '.result.content[0].text')" "cherry"
assert_eq "border_only records the pick" "$(cat "$XDG_RUNTIME_DIR/td-tint/0xaaa")" "cherry"
assert_has "monitor_set turns the knob" "$(line 6 | jq -r '.result.content[0].text')" "GLARE=0.3"
tiles="$(line 7 | jq -r '.result.content[0].text')"
assert_eq "list_tiles sees all four terminal tiles, not chrome" "$(jq 'length' <<<"$tiles")" "4"
assert_eq "list_tiles reads the recorded variant" "$(jq -r '.[] | select(.address=="0xaaa") | .variant' <<<"$tiles")" "cherry"
assert_eq "list_tiles reports the '-' pin as no variant" "$(jq -r '.[] | select(.address=="0xbbb") | .variant' <<<"$tiles")" "null"
assert_eq "list_tiles flags terminal-delight windows" "$(jq -r '.[] | select(.address=="0xddd") | .terminal_delight' <<<"$tiles")" "true"
assert_eq "unknown tool is a JSON-RPC error" "$(line 8 | jq -r '.error.code')" "-32602"
assert_eq "the state tool relays the oracle verbatim" "$(line 9 | jq -r '.result.content[0].text' | jq -r '.focused')" "0xbbb"
assert_eq "list_themes reaches the second source" "$(line 10 | jq -r '.result.content[0].text' | jq 'length')" "4"
assert_has "the crt tool switches the tube through the CLI" "$(line 11 | jq -r '.result.content[0].text')" "flat glass"
assert_eq "…and it lands in the record" "$(rec_crt "$XDG_RUNTIME_DIR/td-tint/0xbbb")" "off"

echo "— the façade covers the engine (ARCHITECTURE.md's one rule)"
# "Every capability is a CLI verb on a tested engine; everything else is a thin
# façade that delegates to it." That rule is only worth having if something
# checks it — and it had already been broken once, silently: the MCP server sat
# a whole release behind `--theme` and `--crt`, so an agent could not reach half
# the paint surface and nothing said so.
#
# Both directions matter. A new engine verb with no tool is the regression that
# happened; a tool naming a verb that no longer exists is the one that happens
# next, when a verb gets renamed.
declare -A FACADE=(
  [list]=list_variants        [json]=list_variants
  [themes]=list_themes        [themes-json]=list_themes
  [state]=state               [sync]=sync
  [crt]=crt                   [saturate]=saturate
  [clear]=clear
)
# Not capabilities: `--` ends option parsing, `--window`/`--border-only`/
# `--theme` are modifiers on other verbs and are covered through paint,
# border_only and paint_theme.
mcp_tools="$(grep -oP '^    "\K[a-z_]+(?=": \{)' "$root/bin/td-mcp" | tr '\n' ' ')"
uncovered=""
for v in $(grep -oP '^--\K[a-z-]*(?=\)$)' "$root/bin/td-tint"); do
  [[ -n $v ]] || continue
  [[ -n "${FACADE[$v]:-}" ]] || { uncovered="$uncovered $v"; continue; }
  grep -qw "${FACADE[$v]}" <<<"$mcp_tools" || uncovered="$uncovered $v(->${FACADE[$v]} missing)"
done
assert_eq "every engine verb is reachable from the MCP façade" "$uncovered" ""

dangling=""
for t in "${FACADE[@]}"; do
  grep -qw "$t" <<<"$mcp_tools" || dangling="$dangling $t"
done
assert_eq "…and every tool this map names still exists" "$dangling" ""
assert_has "the two verbs the façade once missed are named in it" \
  "${FACADE[crt]}/${FACADE[themes]}" "crt/list_themes"

echo "— option terminator (a variant key that looks like a flag)"
# Deliberately last: this installs a third variant, and the counts asserted
# above are part of the contract those blocks test.
mkdir -p "$XDG_CONFIG_HOME/omarchy/themes/terminal-delight--dash"
cp "$here/fixtures/variant-cherry.toml" "$XDG_CONFIG_HOME/omarchy/themes/terminal-delight--dash/colors.toml"
printf '\xe2\x9e\x96\n' > "$XDG_CONFIG_HOME/omarchy/themes/terminal-delight--dash/glyph"

assert_has "--list shows a dash-leading key" "$(bash "$root/bin/td-tint" --list)" "-dash"

err="$(bash "$root/bin/td-tint" -dash 2>&1)"
if [[ $? -ne 0 ]]; then ok "a bare dash-leading key is refused, not mispainted"; else no "a bare dash-leading key is refused"; fi
assert_has "the refusal carries the fix" "$err" "td-tint -- '-dash'"

out="$(bash "$root/bin/td-tint" --window 0xaaa --border-only -- -dash 2>&1)"
if [[ $? -eq 0 ]]; then ok "-- lets the dash-leading key through"; else no "-- lets the dash-leading key through: $out"; fi
assert_eq "the pick is recorded under its real key" "$(rec_variant "$XDG_RUNTIME_DIR/td-tint/0xaaa")" "-dash"

out="$(bash "$root/bin/td-tint" --border-only --window 0xaaa -- -dash 2>&1)"
if [[ $? -eq 0 ]]; then ok "the leading options parse in either order"; else no "leading options parse in either order: $out"; fi

err="$(bash "$root/bin/td-tint" --window 0xaaa -- --clear 2>&1)"
if [[ $? -ne 0 ]]; then ok "-- really terminates: --clear after it is a name, not a verb"; else no "-- really terminates"; fi
assert_has "…and is reported as an unknown palette" "$err" "no palette '--clear'"

echo "— variant keys are constrained at the source"
bad="$(grep -oP '^\[\K[^]]+' "$root/variants.toml" | grep -vE '^[a-z0-9][a-z0-9-]*$')"
assert_eq "every shipped variant key is already safe" "$bad" ""
# build-variants resolves its repo from its own path, so a throwaway copy
# carrying a poisoned variants.toml exercises the gate for real.
fake="$T/fakerepo"
mkdir -p "$fake/bin"
cp "$root/bin/build-variants" "$fake/bin/"
cp "$root/colors.toml" "$fake/colors.toml"
printf '[-evil]\nglyph = "x"\naccent = "#FF0000"\naccent_bright = "#FF8080"\nforeground = "#FFFFFF"\nbackground = "#000000"\nsurface = "#111111"\n' > "$fake/variants.toml"
assert_has "build-variants refuses a dash-leading key" \
  "$(cd "$fake" && python3 bin/build-variants --previews-only 2>&1)" "bad variant key"
assert_has "install-variants' uninstall reader skips it too" \
  "$(printf '[-evil]\n[cherry]\n' | grep -oP '^\[\K[a-z0-9][a-z0-9-]*' | tr '\n' ' ')" "cherry"

echo "— painting a tile with an Omarchy theme"
# Deliberately after the count assertions above: this repaints 0xaaa, which
# those blocks read.
: > "$TD_TEST_LOG/hyprctl.log"
out="$(bash "$root/bin/td-tint" --window 0xaaa --border-only --theme osaka-jade 2>&1)"
assert_has "it says which theme the terminal now wears" "$out" "Osaka Jade"
hlog="$(cat "$TD_TEST_LOG/hyprctl.log")"
assert_has "the frame takes the theme's own accent" "$hlog" 'active_border_color", value = "rgba(509475ee)'
assert_eq "the pick is recorded under the theme's name" "$(rec_variant "$XDG_RUNTIME_DIR/td-tint/0xaaa")" "osaka-jade"
assert_eq "…and under the list it came from" "$(rec_src "$XDG_RUNTIME_DIR/td-tint/0xaaa")" "omarchy"

: > "$TD_TEST_LOG/hyprctl.log"
bash "$root/bin/td-tint" --sync >/dev/null
assert_has "--sync re-frames an Omarchy-sourced pick from its own theme" \
  "$(cat "$TD_TEST_LOG/hyprctl.log")" 'rgba(509475ee)'
assert_eq "…and the sweep leaves the source alone" "$(rec_src "$XDG_RUNTIME_DIR/td-tint/0xaaa")" "omarchy"
assert_eq "the oracle reports the tile's source to the picker" \
  "$(bash "$root/bin/td-tint" --state | jq -r '.tiles[] | select(.address=="0xaaa") | .source')" "omarchy"

err="$(bash "$root/bin/td-tint" --window 0xaaa --theme nosuchtheme 2>&1)"
if [[ $? -ne 0 ]]; then ok "an unknown theme is refused"; else no "an unknown theme is refused"; fi
assert_has "…and the refusal names the list to look in" "$err" "td-tint --themes"

err="$(bash "$root/bin/td-tint" --theme nord cherry 2>&1)"
if [[ $? -ne 0 ]]; then ok "--theme with a stray second name is refused"; else no "--theme with a stray second name is refused"; fi
assert_has "…and the refusal shows the shape that works" "$err" "td-tint --theme 'nord'"

echo "— the CRT switch, end to end"
: > "$TD_TEST_LOG/hyprctl.log"
out="$(bash "$root/bin/td-tint" --window 0xaaa --crt off 2>&1)"
assert_has "it says the tube went out" "$out" "flat glass"
assert_has "the window's rounding is set to zero — the shader variant that has no warp" \
  "$(cat "$TD_TEST_LOG/hyprctl.log")" 'prop = "rounding", value = 0, window = "address:0xaaa"'
assert_eq "the choice is recorded" "$(rec_crt "$XDG_RUNTIME_DIR/td-tint/0xaaa")" "off"
assert_eq "…without disturbing the pick it was wearing" \
  "$(rec_variant "$XDG_RUNTIME_DIR/td-tint/0xaaa")" "osaka-jade"
assert_eq "…or which list that pick came from" "$(rec_src "$XDG_RUNTIME_DIR/td-tint/0xaaa")" "omarchy"

: > "$TD_TEST_LOG/hyprctl.log"
bash "$root/bin/td-tint" --window 0xaaa --crt toggle >/dev/null
assert_eq "toggle brings it back" "$(rec_crt "$XDG_RUNTIME_DIR/td-tint/0xaaa")" "on"
assert_has "…rounded to what the desktop uses, not to a number of our own" \
  "$(cat "$TD_TEST_LOG/hyprctl.log")" 'prop = "rounding", value = 14'

# The first press on an untouched tile is the one that used to do nothing: it
# has no record, so the toggle has to ask the DESKTOP what it is turning off.
rm -f "$XDG_RUNTIME_DIR/td-tint/0xbbb"
bash "$root/bin/td-tint" --window 0xbbb --crt toggle >/dev/null
assert_eq "the first toggle on an inheriting tile turns it OFF" \
  "$(rec_crt "$XDG_RUNTIME_DIR/td-tint/0xbbb")" "off"

: > "$TD_TEST_LOG/hyprctl.log"
bash "$root/bin/td-tint" --window 0xaaa --saturate on >/dev/null 2>&1 || true
assert_eq "saturating a tile does not forget its tube" \
  "$(rec_crt "$XDG_RUNTIME_DIR/td-tint/0xaaa")" "on"

: > "$TD_TEST_LOG/hyprctl.log"
bash "$root/bin/td-tint" --window 0xaaa --border-only --theme osaka-jade >/dev/null
assert_eq "…and neither does repainting it" "$(rec_crt "$XDG_RUNTIME_DIR/td-tint/0xaaa")" "on"

: > "$TD_TEST_LOG/hyprctl.log"
bash "$root/bin/td-tint" --sync >/dev/null
hlog="$(cat "$TD_TEST_LOG/hyprctl.log")"
assert_has "--sync re-pins an explicit CRT choice" "$hlog" 'prop = "rounding", value = 0, window = "address:0xbbb"'
assert_eq "…and leaves a tile that never asked to keep inheriting" \
  "$(grep -c 'prop = "rounding".*address:0xeee' <<<"$hlog")" "0"

: > "$TD_TEST_LOG/hyprctl.log"
bash "$root/bin/td-tint" --window 0xbbb --clear >/dev/null
assert_has "clearing a tile hands the tube back with everything else" \
  "$(cat "$TD_TEST_LOG/hyprctl.log")" 'prop = "rounding", value = 14, window = "address:0xbbb"'
assert_eq "…and the record goes with it" "$(rec_crt "$XDG_RUNTIME_DIR/td-tint/0xbbb")" ""

bash "$root/bin/td-tint" --window 0xeee --crt off >/dev/null
state3="$(bash "$root/bin/td-tint" --state)"
assert_eq "the oracle reports a switched-off tile as off" \
  "$(jq -r '.tiles[] | select(.address=="0xeee") | .crt' <<<"$state3")" "false"
assert_eq "…and a switched-on one as on" \
  "$(jq -r '.tiles[] | select(.address=="0xaaa") | .crt' <<<"$state3")" "true"
if bash "$root/bin/td-tint" --window 0xaaa --crt sideways >/dev/null 2>&1; then
  no "--crt refuses a mode it does not have"
else
  ok "--crt refuses a mode it does not have"
fi

echo "— the palette home retires the theme-shaped install"
# Last, because it changes what `variants()` answers: the point of the new
# home is that it REPLACES the old one rather than adding to it.
mkdir -p "$XDG_DATA_HOME/terminal-delight/palettes/tide"
cp "$here/fixtures/variant-cherry.toml" "$XDG_DATA_HOME/terminal-delight/palettes/tide/colors.toml"
printf '\xf0\x9f\x8c\x8a\n' > "$XDG_DATA_HOME/terminal-delight/palettes/tide/glyph"
list="$(bash "$root/bin/td-tint" --list)"
assert_has "the palette home is read" "$list" "tide"
assert_lacks "…and the theme-shaped install is not read beside it (no doubles)" "$list" "cherry"
assert_eq "the card contract follows the same single home" \
  "$(bash "$root/bin/td-tint" --json | jq 'length')" "1"
assert_eq "a palette in the new home still carries its glyph" \
  "$(bash "$root/bin/td-tint" --json | jq -r '.[0].glyph')" "🌊"
assert_eq "the theme list is unmoved by any of it" \
  "$(bash "$root/bin/td-tint" --themes-json | jq 'length')" "4"

echo "— td-tubes: the per-tile warp registry"
# The registry converts Hyprland's LOGICAL window rects into the screen
# shader's buffer space. Those are the same space only on an UNROTATED
# monitor. On a rotated one they are 90 degrees apart, and a rect converted
# without the rotation claims a completely different region of the screen —
# which is exactly how a first cut ate the bar on a transform-3 display. The
# fixture carries one of each so that can never come back silently.
#
# Last block on purpose: sourcing td-tubes pulls in td-monitor's `set -e` and
# repoints TD_TEST_FIXTURES, neither of which should leak into anything above.
export TD_TEST_FIXTURES="$here/fixtures/tubes"
# shellcheck source=/dev/null
source "$root/bin/td-tubes"
set +eu

tubes="$(tubes_json)"
assert_eq "only the eligible windows get a tube" "$(jq 'length' <<<"$tubes")" "2"
assert_eq "most-recently-focused first — the shader takes the first hit" \
  "$(jq -r '.[0].class' <<<"$tubes")" "google-chrome"
assert_eq "unrotated monitor: origin-shifted and scaled, nothing else" \
  "$(jq -c '.[] | select(.class=="foot") | [.x,.y,.w,.h]' <<<"$tubes")" "[26,134,1478,2000]"
# transform 3 against a 1920x1080 mode is (x,y) -> (1920-y, x), both corners,
# rebuilt axis-aligned. Logical (13,39)+1054x926 therefore lands at
# (955,13)+926x1054 — w and h swap, which is the whole point.
assert_eq "rotated monitor: the rect is rotated into buffer space" \
  "$(jq -c '.[] | select(.class=="google-chrome") | [.x,.y,.w,.h]' <<<"$tubes")" "[955,13,926,1054]"
assert_lacks "terminal-delight is exempt — it warps its own panes" "$tubes" "terminal-delight"

# The screensaver artefact. org.omarchy.screensaver is a FULLSCREEN window, so it
# is already excluded on its own account — and that is exactly why this was
# missed. The offender is every OTHER tube on that monitor: rects for windows the
# fullscreen surface is covering, which tube_at still picks by output pixel and
# warps whatever is drawn on top. Live capture had the fullscreen window straight
# on the half of the screen no tile occupied and bowed inside a bezel box on the
# half one did.
assert_lacks "a fullscreen window gets no tube of its own" "$tubes" "org.omarchy.screensaver"
assert_eq "…and takes the whole monitor's tubes with it — nothing under it is visible" \
  "$(jq '[.[] | select(.mon == 2)] | length' <<<"$tubes")" "0"
assert_eq "…while the monitors it does not cover are untouched" \
  "$(jq '[.[] | select(.mon != 2)] | length' <<<"$tubes")" "2"

# A lock screen is a LAYER, so nothing in `clients -j` can stand for it. Same
# artefact, different surface. The wallpaper is a full-size layer too, which is
# why only levels 2 and 3 count — it sits under the windows, not over them.
export TD_TEST_FIXTURES="$here/fixtures/tubes-locked"
locked="$(tubes_json)"
assert_eq "a layer covering the output drops that monitor's tubes" \
  "$(jq '[.[] | select(.mon == 0)] | length' <<<"$locked")" "0"
assert_eq "…and a small overlay (a notification) does not" \
  "$(jq '[.[] | select(.mon == 1)] | length' <<<"$locked")" "1"
export TD_TEST_FIXTURES="$here/fixtures/tubes"

block="$(emit_block "$tubes")"
assert_has "the baked block declares its count" "$block" "#define TUBE_COUNT 2"
assert_has "rects are floats, not bare ints one driver would reject" "$block" \
  "vec4(955.0, 13.0, 926.0, 1054.0)"
assert_has "each rect carries the monitor it belongs to" "$block" "1, 0"
assert_eq "an empty layout emits no array — GLSL forbids a zero-length one" \
  "$(emit_block '[]' | grep -c 'TUBE_RECT')" "0"
assert_has "…and still declares the count, so the #if drops the rest" \
  "$(emit_block '[]')" "#define TUBE_COUNT 0"

# And the frag in this repo must itself be at zero. `apply` rewrites the block
# in the INSTALLED theme, but anyone whose checkout IS the installed theme
# rewrites the checkout — and would commit their own window rects as what every
# stranger gets on install. It is also the premise under which this change ships
# no new screenshot: at zero the tube path compiles out and the picture cannot
# have moved. Both claims, one line.
assert_eq "the frag ships with no tubes of its own" \
  "$(grep -c '^#define TUBE_COUNT 0$' "$root/crt-glass.frag")" "1"

# The state the tubes are only correct UNDER. Both of these were invisible
# until they produced artefacts nobody could name: a snapshot with no watcher
# rots on the next layout change, and the per-window warp left installed bows
# every window a second time while the cursor is bowed once — which is the
# click drift the tubes were built to remove, reintroduced.
# The suite already seeds surface.frag up top, as install-curve.sh would leave
# it — so the conflict is the state we are ALREADY in here, and the clear case
# is the one that has to be arranged.
assert_eq "surface.frag present IS the conflict — both tiers bow the same window" \
  "$(window_warp_live && echo conflict || echo clear)" "conflict"
assert_has "…and the report says so, with the way out" "$(state_report)" "CONFLICT"
mv "$XDG_CONFIG_HOME/hypr/shaders/surface.frag" "$T/warp.away"
assert_eq "moved aside, as --tubes does, reads as no conflict" \
  "$(window_warp_live && echo conflict || echo clear)" "clear"
mv "$T/warp.away" "$XDG_CONFIG_HOME/hypr/shaders/surface.frag"

# A missing watcher must be LOUD. This is the whole failure mode: `apply` looks
# like it worked, and stays looking that way while the rects rot.
watcher_running() { return 1; }
assert_has "a missing watcher is reported, not assumed" "$(state_report)" "NOT RUNNING"
assert_has "…and names the command that fixes it" "$(state_report)" "systemctl --user enable --now"
watcher_running() { return 0; }
assert_lacks "a running watcher says nothing alarming" "$(state_report)" "NOT RUNNING"

# The socket lookup has to survive systemd, which does not hand a user unit
# Hyprland's environment. Under `set -u` the old form died on an unbound
# HYPRLAND_INSTANCE_SIGNATURE — i.e. the unit could never have worked.
XDG_RUNTIME_DIR="$T/run" HYPRLAND_INSTANCE_SIGNATURE="" hypr_event_socket >/dev/null 2>&1
assert_eq "no compositor: fails cleanly rather than crashing on an unset signature" "$?" "1"
assert_has "…and says which directory it looked in" "$SOCK_ERR" "$T/run/hypr"

# The unit file, checked by systemd itself rather than by eye. systemd only
# WARNS about a key in the wrong section and then ignores it, so a misplaced
# StartLimitIntervalSec costs you the rate limit and says nothing at the point
# of use — which is exactly what happened when this was written.
if command -v systemd-analyze >/dev/null 2>&1; then
  sed "s|@TD_TUBES@|/bin/true|g" "$root/systemd/td-tubes.service" >"$T/td-tubes.service"
  unit_out="$(systemd-analyze verify "$T/td-tubes.service" 2>&1)"
  assert_lacks "the unit has no keys in the wrong section" "$unit_out" "Unknown key"
  assert_lacks "…and no unit-file syntax errors" "$unit_out" "Failed to parse"
else
  printf '  \033[90m–\033[0m systemd-analyze absent — unit file not verified here\n'
fi

echo
if [[ "$fail" -eq 0 ]]; then
  printf '\033[32mall %d green\033[0m\n' "$pass"
  exit 0
else
  printf '\033[31m%d failing (of %d)\033[0m\n' "$fail" "$((pass + fail))"
  exit 1
fi
