#!/usr/bin/env bash
# td-tubes — the per-tile warp registry for the monitor pass.
#
#   td-tubes                what would be baked right now, and why
#   td-tubes apply          bake the live layout into the shader
#   td-tubes off            bake zero tubes (flat desktop, glass intact)
#   td-tubes watch          re-apply on every layout change until interrupted
#
# This is terminal-delight's app/src/warp.rs with a different clock. There,
# every visible pane registers its content rect during prepaint and the CRT
# pass warps exactly those rects; the registry is rebuilt each frame. Here the
# tiles register on each Hyprland layout event and the monitor pass warps
# exactly those rects.
#
# WHY THE MONITOR PASS AND NOT THE WINDOW SHADER. shaders/surface.frag bows a
# window during renderWorkspace(), which runs BEFORE renderSoftwareCursorsFor()
# composites the cursor. The picture moves; the cursor and the click do not.
# That is not a tuning problem, it is which pass you are in — measured at
# k1=0.14/k2=0.06 the visible content at a window's rim sits ~1.7% of its width
# inboard of where the click lands, and ~4.25% at the corner. The monitor pass
# runs after the cursor is in the buffer, so warping here carries cursor and
# content together and the click lands where you aimed.
#
# Hyprland screen shaders take no custom uniforms, so "pass the rects in" means
# rewriting a const block and recompiling — the trick td-monitor already uses
# for the knob block. A few ms, no relogin.
set -euo pipefail

# td-monitor stops at its own sourcing guard, handing us family(), STAGED,
# set_shader(), recompile() and die() rather than a second copy of each.
TD_MONITOR="$(command -v td-monitor || true)"
[[ -x "$TD_MONITOR" ]] || { echo "td-tubes: td-monitor not on PATH" >&2; exit 1; }
# shellcheck source=/dev/null
source "$TD_MONITOR"

BEGIN='// ---- TUBE DATA (managed by td-tubes — do not hand-edit) ----'
END='// ---- END TUBE DATA ----'

# The shader loops over this many rects per fragment, so it is a real cost, not
# a formality. Anything past it is DROPPED — and said out loud, because a
# silent cap reads as "we covered everything" when we did not.
MAX_TUBES=24

need() { command -v "$1" >/dev/null || die "$1 is required"; }

# THE TWO PRECONDITIONS. A tube in the monitor pass is only honest when both
# hold, and each fails in its own visible way, so the tool sets them rather
# than trusting anyone to remember:
#
#   cursor:no_hardware_cursors = 1
#     A hardware cursor is a scanout plane the shader never touches, so the
#     picture bends and the pointer does not — which is the drift we came here
#     to kill. A software cursor is composited into the buffer the shader
#     gathers from, so it bends WITH the content and the click lands.
#
#   debug:damage_tracking = 0
#     The warp is a gather: the output pixel at P samples the source at
#     tube_map(P), somewhere else. Re-blitting only a damaged rect leaves every
#     pixel in it whose source lies outside stale — and a software cursor
#     damages a fresh small rect every frame it moves, so it reads as tearing
#     under mouse movement specifically. Full-frame redraw is the price of the
#     gather. Note it is per CHANGED frame, not per vsync: an idle desktop
#     still renders nothing.
#
# Both are runtime-only (`hyprctl eval`), so a `hyprctl reload` drops them —
# which is why `watch` re-asserts on configreloaded.
precond_set() {
  hyprctl eval 'hl.config({ cursor = { no_hardware_cursors = 1 }, debug = { damage_tracking = 0 } })' >/dev/null
}

precond_clear() {
  hyprctl eval 'hl.config({ cursor = { no_hardware_cursors = 2 }, debug = { damage_tracking = 2 } })' >/dev/null
}

# Report rather than assume — the point is that a wrong value is diagnosable
# instead of being blamed on the warp.
precond_report() {
  local hw dt
  hw="$(hyprctl getoption cursor:no_hardware_cursors | awk '/int:/{print $2}')"
  dt="$(hyprctl getoption debug:damage_tracking | awk '/int:/{print $2}')"
  [[ "$hw" == 1 ]] && echo "  cursor:no_hardware_cursors = 1  ok — the cursor rides the shader" ||
    echo "  cursor:no_hardware_cursors = $hw  WRONG — clicks will drift again (want 1)"
  [[ "$dt" == 0 ]] && echo "  debug:damage_tracking      = 0  ok — no stale pixels under the gather" ||
    echo "  debug:damage_tracking      = $dt  WRONG — expect tearing on mouse movement (want 0)"
}

# The two pieces of state that decide whether the tubes are TRUE, as opposed to
# merely present. Both were invisible until they produced artefacts nobody could
# name, so both are reported next to the preconditions now.
#
# THE WATCHER. `apply` bakes a snapshot. A tube is a rect, and a rect is only
# right until the next window opens, closes or moves — which is constantly. With
# no watcher the shader keeps warping through rects for a layout that is gone,
# and because tube_at() picks the tube by OUTPUT pixel, two things that used to
# share a map stop sharing one: the pointer lands in one dead rect while the
# button it is aimed at lands in another, or in none. That reads as three
# separate bugs — content tiled onto the wrong tiles, duplicated fragments of
# one window inside another, and clicks that miss — and it is one.
watcher_running() { pgrep -f 'td-tubes watch' >/dev/null 2>&1; }

# Hyprland's event socket, without requiring Hyprland's environment.
# `HYPRLAND_INSTANCE_SIGNATURE` is exported into the session's processes, and a
# systemd user unit is not one of them unless something imported the
# environment first — so the unit would die on an unbound variable and the
# whole point of shipping a unit would be lost. Fall back to the one live
# instance under $XDG_RUNTIME_DIR, and refuse rather than guess if there are
# several: picking the wrong compositor silently is worse than not starting.
SOCK_ERR=""
hypr_event_socket() {
  local base="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr"
  local sig="${HYPRLAND_INSTANCE_SIGNATURE:-}" s found=()
  if [[ -n $sig && -S "$base/$sig/.socket2.sock" ]]; then
    echo "$base/$sig/.socket2.sock"
    return 0
  fi
  for s in "$base"/*/.socket2.sock; do [[ -S $s ]] && found+=("$s"); done
  case ${#found[@]} in
  1) echo "${found[0]}" ;;
  0)
    SOCK_ERR="no Hyprland event socket under $base — is Hyprland running?"
    return 1
    ;;
  *)
    SOCK_ERR="${#found[@]} Hyprland instances under $base — set HYPRLAND_INSTANCE_SIGNATURE to pick one"
    return 1
    ;;
  esac
}

# THE OTHER WARP. shaders/surface.frag bows each window during renderWorkspace().
# The tubes exist precisely because that pass cannot be click-correct (see the
# header). Running both does not average out: content is displaced twice and the
# cursor once, so the miss the tubes were built to remove comes straight back.
window_warp_dir() { echo "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/shaders"; }
window_warp_live() { [[ -f "$(window_warp_dir)/surface.frag" ]]; }

state_report() {
  if watcher_running; then
    echo "  watcher                         ok — tubes follow the layout"
  else
    echo "  watcher                         NOT RUNNING — these rects are a snapshot and"
    echo "                                  rot on the next layout change. Start it with:"
    echo "                                    systemctl --user enable --now td-tubes.service"
    echo "                                  (or run 'td-tubes watch' in a spare terminal)"
  fi
  # "on disk", NOT "on screen". A per-window shader is compiled at login and
  # survives both deleting the file and `hyprctl reload` — measured, see
  # docs/ARCHITECTURE.md. So the file being gone means the NEXT session is clean,
  # and says nothing about this one. Claiming "off" here is what let a live
  # double warp sit under a green status line for a whole afternoon.
  if window_warp_live; then
    echo "  per-window warp                 CONFLICT — $(window_warp_dir)/surface.frag is"
    echo "                                  installed and bows every window a second time."
    echo "                                  Content moves twice, the cursor once, and the"
    echo "                                  clicks drift again. ./install-curve.sh --tubes"
    echo "                                  moves it aside reversibly."
  else
    echo "  per-window warp                 none on disk — but a session that STARTED with"
    echo "                                  one is still running it: the shader is compiled"
    echo "                                  at login and survives both rm and hyprctl"
    echo "                                  reload. Check with test/probe-warp-count;"
    echo "                                  a logout is the only way to drop it."
  fi
}

# Every window that should wear a tube, most-recently-focused first (the shader
# takes the first hit, so that ordering is what makes a stacked window win the
# pixels it covers).
#
# Coordinates. hyprctl reports LOGICAL, monitor-global, in the monitor's
# rotated orientation. The screen shader runs in the compositing buffer, which
# keeps the monitor's MODE orientation — Hyprland rotates at the final blit.
# On an unrotated monitor those are the same space and the difference is
# invisible; on a rotated one they are 90 degrees apart, and a rect converted
# without the rotation claims a completely different region of the screen.
#
# Measured, not assumed: on a transform-3 monitor the shader's own scanlines
# (drawn as mod(uv.y * res.y, SCAN_STEP), horizontal by construction) come out
# VERTICAL, in a clean period-4 repeat. The buffer is landscape; the output is
# portrait.
#
# The rotation below is Hyprutils' Vector2D::transform verbatim, with
# monitorSize = the mode, which is what Hyprland passes it when it maps the
# pointer into shader space (Renderer/OpenGL.cpp, renderToOutputInternal).
tubes_json() {
  need hyprctl
  need jq
  local mons clients layers
  mons="$(hyprctl monitors -j 2>/dev/null)"
  clients="$(hyprctl clients -j 2>/dev/null)"
  layers="$(hyprctl layers -j 2>/dev/null)"
  # When hyprctl cannot reach a compositor — over ssh without the session
  # environment, or from a unit that starts before the session is up — it does
  # not fail and it does not stay quiet. It prints a SENTENCE on stdout:
  #
  #     HYPRLAND_INSTANCE_SIGNATURE not set! (is hyprland running?)
  #
  # which is neither empty nor JSON, so a non-empty check sails past it and
  # `--argjson` answers with a jq usage dump that sends the reader into jq
  # instead of into their session. Test for PARSEABLE, not for present, and
  # quote what hyprctl actually said.
  json_ok() { jq -e . >/dev/null 2>&1 <<<"${1:-}"; }
  if ! json_ok "$mons" || ! json_ok "$clients"; then
    die "cannot reach Hyprland — hyprctl said: $(head -1 <<<"${mons:-nothing at all}")"
  fi
  json_ok "$layers" || layers='{}'
  jq -n --argjson m "$mons" --argjson c "$clients" --argjson l "$layers" '
    def xf($t; $W; $H): . as [$x, $y]
      | if   $t == 1 then [$y,      $H - $x]
        elif $t == 2 then [$W - $x, $H - $y]
        elif $t == 3 then [$W - $y, $x     ]
        elif $t == 4 then [$W - $x, $y     ]
        elif $t == 5 then [$y,      $x     ]
        elif $t == 6 then [$x,      $H - $y]
        elif $t == 7 then [$W - $y, $H - $x]
        else                [$x,      $y     ] end;
    ($m | map({ key: (.id | tostring),
                value: { x: .x, y: .y, scale: .scale, w: .width, h: .height,
                         t: .transform, ws: .activeWorkspace.id,
                         special: (.specialWorkspace.id // 0) } })
        | from_entries) as $mon
    # `hyprctl layers` is keyed by monitor NAME while everything else here works
    # in ids, so the layer arm needs the same monitor facts under the other key.
    | ($m | map({ key: .name,
                  value: { id: .id, x: .x, y: .y, scale: .scale,
                           w: .width, h: .height, t: .transform } })
        | from_entries) as $by_name
    # THE INVARIANT: every visible surface claims its own rect, so nothing is
    # ever warped by a rect that is not its own.
    #
    # tube_at picks a tube by OUTPUT PIXEL. A surface that is DRAWN but has no
    # tube of its own therefore gets whatever rect happens to lie beneath it —
    # and that is the tear, every time. The screensaver, the scratchpad, the
    # calculator, the keybindings menu: not new bugs, the same bug, arriving
    # through whichever surface this list failed to enumerate.
    #
    # Be exact about how that kept happening, because the shape repeats. The
    # first sightings were all CLIENTS dropped by a filter, so each was fixed by
    # widening the filter, and the filter now drops nothing: fullscreen windows
    # are in, special-workspace windows are in, and a window that must not bow
    # gets curvature 0 rather than being omitted. That run of successes is what
    # hid the real hole. The invariant says every visible SURFACE — and a client
    # is only one of the two kinds Hyprland draws. LAYERS (the bar, the menu,
    # notifications, pickers) were never claimants at all: this program read
    # `hyprctl layers` for exactly one purpose, deciding whether a lock was up.
    # So the entire layer class sat permanently in the failure the invariant
    # exists to forbid, and no amount of widening the client filter could ever
    # reach it. They are enumerated below on the same terms as clients.
    #
    # What remains below is the one honest case: a surface we cannot enumerate
    # or place. There is no rect to give it, so the partition is unknowable and
    # the monitor gets NO tubes at all. That is a statement about our knowledge,
    # not a list of exceptions, and it is why it does not grow.
    | ( [ $m[]
          | . as $mm
          | select((.solitaryBlockedBy // []) | index("LOCK"))
          | $mm.id ]
        # A LOCK SCREEN drawn as a layer — hyprlock and friends, which is what
        # other setups use even though Omarchy does not (see below). Namespace
        # matched, NOT size alone: `omarchy-menu` is also a full-output layer at
        # level 3, and it is translucent — the desktop is meant to show through
        # it, bowed. Sizing alone flattened the whole desktop every time the menu
        # opened, which is a worse bug than the one being fixed and is how this
        # narrowing was earned.
        + [ $m[]
            | . as $mm
            | ((($l[$mm.name].levels["2"] // []) + ($l[$mm.name].levels["3"] // []))
               | any((((.namespace // "") | ascii_downcase) | test("lock"))
                     and (.w * .h >= (($mm.width / $mm.scale) * ($mm.height / $mm.scale) * 0.95))))
              as $locked_by_layer
            | select($locked_by_layer)
            | $mm.id ]
        # And the lock screen, which is NEITHER. Omarchy does not use hyprlock —
        # it locks through omarchy-shell, whose lock is a Quickshell
        # ext-session-lock surface. That protocol is not a layer and not a
        # client, so `hyprctl layers` and `hyprctl clients` are both blind to it
        # and no openlayer ever fires. The tell is second-hand, and it is
        # Omarchy own: a session lock is one of the reasons a monitor cannot go
        # solitary, so LOCK turns up in solitaryBlockedBy — see
        # /usr/share/omarchy/bin/omarchy-hyprland-session-locked. Detected in the
        # first arm above, which is where the "we cannot place it" cases live.
        | unique ) as $covered
    # LAYERS, on the same terms as clients: a rect of their own, so no other map
    # can reach them. (No apostrophes in here either — see the note further down;
    # one ends this single-quoted jq program and the failure reads as a bash
    # syntax error 40 lines away.) Levels 2 and 3 only: level 0 is the wallpaper
    # and level 1 sits UNDER the windows, so neither is ever drawn over a tile.
    #
    # Flat. A tube is a screen; a layer is drawn ON the glass — a bar, a dock, a
    # sized panel. Bowing a 26 px strip inside its own rect shears it and the
    # bezel eats its edge, so curvature 0 is what a layer wants: immune to its
    # neighbours, undistorted itself.
    #
    # A COVERING layer is a different animal and needs saying carefully, because
    # the obvious rule is wrong twice over. Every Quickshell overlay Omarchy
    # ships — the menu, the notifications, the pickers — is a full-output HOST
    # surface. Its rect is the whole monitor whatever it happens to be drawing,
    # so the rect tells us nothing about where the content is, and the content is
    # composited into the buffer BEFORE this shader runs. Toast pixels and
    # desktop pixels arrive already blended. No single-pass gather can unwarp one
    # and not the other; this is the same shape as the cursor problem, and it is
    # not tunable either.
    #
    # It claims the whole output, FLAT. Three candidate rules were tried against
    # real screens before this one, and the two obvious ones are both wrong:
    #
    #   claim nothing        The desktop is untouched and the overlay is drawn
    #                        through whatever tiles lie under it, so it tears at
    #                        their seams — and a tile bezel blacks whatever is
    #                        drawn over its rim, which is the hard cut through a
    #                        toast rather than a mere bend. Photographed twice.
    #   claim it BOWED       Keeps the desktop bowed under a translucent card,
    #                        which is why it looked right for the menu. But a
    #                        full-output tube sits ABOVE every tile it covers,
    #                        so it also takes the pixels of a window that opted
    #                        out at curvature 0 — terminal-delight, which warps
    #                        its own panes — and warps it a second time. On a
    #                        monitor filled by one such window that is every
    #                        pixel on the screen. The curvature-0 opt-out cannot
    #                        survive anything claiming over the top of it bowed.
    #   claim it FLAT        An identity map draws no bezel and distorts nothing,
    #                        so the overlay renders whole and sharp, and no
    #                        opted-out window can be warped twice — identity
    #                        composes with anything. The desktop unbows for as
    #                        long as the overlay is up, which is the honest cost
    #                        and the only one of the three that is a change of
    #                        DEGREE rather than a broken picture.
    #
    # So there is no namespace table here, and no list to grow: every layer is
    # flat, sized or covering. The one namespace rule left is the lock, in the
    # arm above, and it is not about curvature at all — a lock covers the screen
    # with something we cannot enumerate, so the partition is unknowable and the
    # monitor gets no tubes rather than a flat one.
    | [ $l | to_entries[]
        | ($by_name[.key]) as $mo
        | select($mo != null)
        | select(($covered | index($mo.id)) == null)
        | (.value.levels // {}) | to_entries[]
        | (.key | tonumber) as $lvl
        | select($lvl == 2 or $lvl == 3)
        | .value[]
        | select(.w > 0 and .h > 0)
        | . as $ly
        # A LAYER NOBODY CAN SEE MUST NOT CLAIM. Level 2 is TOP, and Hyprland
        # draws a fullscreen window over it -- but the layer stays mapped, so it
        # is still listed here and used to still get a rect. The bar then owned
        # a strip of a window it was not drawing on: that strip rendered flat
        # through the bar identity map while the rest of the window bowed
        # through its own, and the clip below carved the window tube to start
        # underneath it. The result is a band of app chrome across the top of a
        # bowed fullscreen window, photographed on DP-2.
        #
        # Geometric, not a fullscreen flag: a visible client that FULLY CONTAINS
        # the layer rect is covering it, whatever Hyprland calls that state.
        # Needs no monitor size and no transform, and it catches a full-output
        # client that is not flagged fullscreen too. Level 3 is OVERLAY, which
        # draws above fullscreen, so it keeps its claim.
        | select($lvl == 3 or ([ $c[]
            | select(.mapped and (.hidden | not))
            | select(.monitor == $mo.id)
            | select(.at[0] <= $ly.x and .at[1] <= $ly.y
                     and (.at[0] + .size[0]) >= ($ly.x + $ly.w)
                     and (.at[1] + .size[1]) >= ($ly.y + $ly.h)) ] | length) == 0)
        | (($ly.x - $mo.x) * $mo.scale) as $x0
        | (($ly.y - $mo.y) * $mo.scale) as $y0
        | ($x0 + $ly.w * $mo.scale)     as $x1
        | ($y0 + $ly.h * $mo.scale)     as $y1
        | ([$x0, $y0] | xf($mo.t; $mo.w; $mo.h)) as $a
        | ([$x1, $y1] | xf($mo.t; $mo.w; $mo.h)) as $b
        | { mon:   $mo.id,
            class: ($ly.namespace // "layer"),
            x: ([$a[0], $b[0]] | min),
            y: ([$a[1], $b[1]] | min),
            w: (($b[0] - $a[0]) | length),
            h: (($b[1] - $a[1]) | length),
            # Flat, always. See the note above: bowed would warp an opted-out
            # window twice, and identity is the only map that composes.
            curv:  0,
            lvl:   $lvl } ] as $layer_tubes
    | ( [ $c[]
        | select(.mapped and (.hidden | not))
        | select((.monitor) as $mn | ($covered | index($mn)) == null)
        | ($mon[.monitor | tostring]) as $mo
        # VISIBLE ON THIS MONITOR, which is not the same as "on its active
        # workspace". A shown special workspace — the scratchpad, ws -98 — is
        # drawn over the tiles and was being dropped by a `.workspace.id > 0`
        # test, so it wore whatever tile lay beneath it.
        | select($mo != null
                 and (.workspace.id == $mo.ws
                      or ($mo.special != 0 and .workspace.id == $mo.special)))
        | (((.at[0] - $mo.x) * $mo.scale)) as $x0
        | (((.at[1] - $mo.y) * $mo.scale)) as $y0
        | ($x0 + .size[0] * $mo.scale)     as $x1
        | ($y0 + .size[1] * $mo.scale)     as $y1
        # Rotate both corners, then rebuild axis-aligned: a 90-degree turn
        # swaps which corner is the top-left, so taking min/max is what keeps
        # w and h positive for every one of the eight transforms.
        | ([$x0, $y0] | xf($mo.t; $mo.w; $mo.h)) as $a
        | ([$x1, $y1] | xf($mo.t; $mo.w; $mo.h)) as $b
        | { mon:   .monitor,
            class: .class,
            x: ([$a[0], $b[0]] | min),
            y: ([$a[1], $b[1]] | min),
            w: (($b[0] - $a[0]) | length),
            h: (($b[1] - $a[1]) | length),
            # Curvature 0 is how a surface opts out WITHOUT leaving a hole.
            # Terminal Delight warps its own panes and hit-tests through the
            # same map, so bending it here would bend it twice — but simply
            # omitting it left its pixels unclaimed, free to be drawn through a
            # neighbouring map. It claims them flat instead. (No apostrophes in
            # here: this jq program is single-quoted and one would end it.)
            curv:  (if .class == "terminal-delight" then 0 else 1 end),
            # The Hyprland address of this window, carried so a consumer can
            # follow a SPECIFIC window across layout changes rather than guessing
            # from a rect. The baker here never reads it — emit_block, cap and
            # describe all pick named fields — so the shader block stays byte for
            # byte the same. The omarchy-crt ignition watch keys its per-window
            # power-on/off effects on it: socket2 events name the window that
            # opened or closed by address, and matching that to a rect is how a
            # closing window is animated without every sibling that reflowed
            # reading as a death and a birth. Layers carry none: no address, no
            # ignition. (No apostrophes in here: this jq program is single-quoted
            # and one would end it.)
            addr:  .address,
            fh: .focusHistoryID } ]
        | sort_by(.fh) ) as $client_tubes
    # Layers draw above windows, so they claim first — level 3 over level 2,
    # then clients most-recently-focused first. tube_at takes the first hit, and
    # the order only ever means anything within one monitor.
    | ($layer_tubes | sort_by(-.lvl) | map(del(.lvl))) as $lt
    # CLAIMING WAS ONLY HALF THE RULE. Ordering decides who OWNS a pixel; it does
    # nothing about where the MAP of a tube reaches. A gather maps its whole rect
    # into whatever of itself is still visible, so when two rects overlap, the
    # covered band is drawn TWICE — once at 1:1 by the tube on top, and once
    # again, squeezed, by the tube underneath pulling it back into view.
    #
    # Measured on the shape that produced it: a full-screen window (0,0,2560,1600)
    # at curvature 1 with the bar claiming (0,0,2560,41.6) flat over its top.
    # Screen rows 0..41.6 show source rows 0..41.6 at 1:1; screen rows 41..65 show
    # source rows 14.8..41.3 again, compressed. That is a toolbar drawn twice, a
    # few pixels apart, and it is what the bar claim bought before this clip.
    # Before the bar claimed anything the window tube owned every row and its map
    # was monotonic over the whole screen, so each source row appeared once.
    #
    # So a tube claims what remains VISIBLE of itself. Full generality is not
    # available — subtracting a rect from the middle of a rect is not a rect —
    # but the case that matters is: edge chrome, which spans a full edge, so the
    # subtraction stays a rect. A covering layer clips nothing (it fails both
    # partial tests below) and needs to: it owns every pixel already, so no map
    # beneath it is ever evaluated.
    | ( $client_tubes
        | map( . as $c0
               | reduce ($lt[] | select(.mon == $c0.mon)) as $l ($c0;
                   . as $c
                   # Spans it horizontally: can only be eating the top or bottom.
                   | if ($l.x <= $c.x and ($l.x + $l.w) >= ($c.x + $c.w))
                     then if ($l.y <= $c.y
                              and ($l.y + $l.h) > $c.y
                              and ($l.y + $l.h) < ($c.y + $c.h))
                          then .h = ($c.h - (($l.y + $l.h) - $c.y))
                             | .y = ($l.y + $l.h)
                          elif (($l.y + $l.h) >= ($c.y + $c.h)
                                and $l.y > $c.y
                                and $l.y < ($c.y + $c.h))
                          then .h = ($l.y - $c.y)
                          else . end
                     else . end
                   | . as $c
                   # Spans it vertically: the left or right edge, same shape.
                   | if ($l.y <= $c.y and ($l.y + $l.h) >= ($c.y + $c.h))
                     then if ($l.x <= $c.x
                              and ($l.x + $l.w) > $c.x
                              and ($l.x + $l.w) < ($c.x + $c.w))
                          then .w = ($c.w - (($l.x + $l.w) - $c.x))
                             | .x = ($l.x + $l.w)
                          elif (($l.x + $l.w) >= ($c.x + $c.w)
                                and $l.x > $c.x
                                and $l.x < ($c.x + $c.w))
                          then .w = ($l.x - $c.x)
                          else . end
                     else . end ) )
        | map(select(.w > 0 and .h > 0)) ) as $clipped
    | $lt + $clipped
  '
}

# The TUBE DATA block for a given rect list. GLSL forbids a zero-length array,
# so an empty layout emits the count alone and the #if in the shader drops the
# arrays, the loop and the map with it.
emit_block() {
  local json="$1" n
  n="$(jq 'length' <<<"$json")"
  echo "$BEGIN"
  echo "#define TUBE_COUNT $n"
  if [[ "$n" -gt 0 ]]; then
    echo "#if TUBE_COUNT > 0"
    echo "const vec4 TUBE_RECT[TUBE_COUNT] = vec4[TUBE_COUNT]("
    # Explicit float literals: GLSL ES will widen an int, but a vec4 of bare
    # ints is the kind of thing one driver accepts and the next one rejects.
    jq -r 'def f: . * 1.0 | tostring | if test("[.]") then . else . + ".0" end;
      to_entries | length as $n | .[] |
      "    vec4(\(.value.x|f), \(.value.y|f), \(.value.w|f), \(.value.h|f))\(if .key == $n - 1 then "" else "," end) // \(.value.class)"' <<<"$json"
    echo ");"
    echo "const int  TUBE_MON[TUBE_COUNT]  = int[TUBE_COUNT]("
    jq -r '[.[].mon | tostring] | join(", ") | "    " + .' <<<"$json"
    echo ");"
    # Floats again, and for the same reason as the rects: a GLSL float array
    # written as bare ints is accepted by one driver and rejected by the next.
    echo "const float TUBE_CURV[TUBE_COUNT] = float[TUBE_COUNT]("
    jq -r '[.[] | (.curv // 1) * 1.0 | tostring
                  | if test("[.]") then . else . + ".0" end] | join(", ") | "    " + .' <<<"$json"
    echo ");"
    echo "#endif"
  fi
  echo "$END"
}

# Swap the block into every installed copy of the monitor pass, but validate a
# scratch copy FIRST so a bad rect list can never reach the live compositor.
# Returns 1 — no error, just "nothing moved" — when the baked shader is
# byte-identical to what is already installed. The watcher leans on that:
# focus changes fire constantly and only matter when they reorder overlapping
# tiles, so without this every alt-tab would pay for a shader recompile.
bake() {
  local json="$1"
  local files; mapfile -t files < <(family)
  [[ -f "$STAGED" ]] && files+=("$STAGED")
  [[ ${#files[@]} -gt 0 ]] || die "no Terminal Delight monitor pass installed"

  grep -qF "$BEGIN" "${files[0]}" || die "no TUBE DATA block in ${files[0]} — reinstall the theme"

  local block probe
  block="$(mktemp)"; probe="$(mktemp --suffix=.frag)"
  emit_block "$json" >"$block"

  awk -v b="$BEGIN" -v e="$END" -v bf="$block" '
    index($0, b) { skip = 1; while ((getline line < bf) > 0) print line; close(bf) }
    !skip        { print }
    index($0, e) { skip = 0 }
  ' "${files[0]}" >"$probe"

  if command -v glslangValidator >/dev/null; then
    glslangValidator "$probe" >/dev/null || { rm -f "$probe" "$block"; die "baked shader does not compile — nothing applied"; }
  else
    echo "warning: glslangValidator not installed; applying unvalidated" >&2
  fi

  if cmp -s "$probe" "${files[0]}"; then
    rm -f "$probe" "$block"
    return 1
  fi

  local f
  for f in "${files[@]}"; do cp "$probe" "$f"; done
  rm -f "$probe" "$block"
}

describe() {
  local json="$1" n
  n="$(jq 'length' <<<"$json")"
  echo "$n tube(s):"
  jq -r '.[] | "  mon \(.mon)  \(.x)x\(.y) +\(.w)x\(.h)  \(.class)"' <<<"$json"
}

# Trim to MAX_TUBES, loudly — and by WHOLE MONITORS.
#
# Slicing the list at 24 was the same bug as any other dropped surface, only
# written by us: the surfaces past the cut are still DRAWN, they just lose their
# rects and get warped through whichever neighbour survived the cut. There is no
# such thing as a partially partitioned monitor. So the budget is spent a monitor
# at a time and one that does not fit goes flat rather than torn — the same
# answer this program already gives for a surface it cannot place.
cap() {
  local json="$1" n res
  n="$(jq 'length' <<<"$json")"
  if [[ "$n" -le "$MAX_TUBES" ]]; then printf '%s' "$json"; return 0; fi
  res="$(jq -c --argjson max "$MAX_TUBES" '
    reduce (group_by(.mon)[]) as $g
      ({ n: 0, keep: [], dropped: [] };
       if (.n + ($g | length)) <= $max
       then .n = .n + ($g | length) | .keep = .keep + $g
       else .dropped = .dropped + $g
       end)' <<<"$json")"
  echo "td-tubes: $n surfaces, over the $MAX_TUBES-tube budget — these monitors go FLAT rather than torn:" >&2
  jq -r '.dropped | group_by(.mon)[] | "  mon \(.[0].mon): \(length) surface(s)"' <<<"$res" >&2
  jq '.keep' <<<"$res"
}

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then return 0 2>/dev/null || true; fi

case "${1:-list}" in
list)
  describe "$(cap "$(tubes_json)")"
  echo "preconditions:"
  precond_report
  state_report
  ;;
apply)
  json="$(cap "$(tubes_json)")"
  describe "$json"
  precond_set
  if bake "$json"; then recompile; else echo "unchanged — nothing recompiled"; fi
  precond_report
  state_report
  ;;
off)
  precond_clear
  if bake '[]'; then
    echo "0 tube(s): the glass is flat"
    recompile
  else
    echo "already flat"
  fi
  echo "  cursor and damage tracking handed back to Hyprland's defaults"
  ;;
watch)
  need socat
  sock="$(hypr_event_socket)" || die "$SOCK_ERR"
  # Every event that can move a tile. There is no per-frame event for a live
  # drag-resize, so a tube lags the drag and snaps true on release — a known
  # edge, not a mystery.
  echo "td-tubes: watching $sock (ctrl-c to stop)"
  precond_set
  json="$(cap "$(tubes_json)")"
  if bake "$json"; then recompile >/dev/null; fi
  # THE LOCK HAS NO EVENT. Every other trigger here arrives on the socket, but
  # an ext-session-lock is neither a window nor a layer and Hyprland announces
  # it to nobody — so a lock screen would come up over rects that are still
  # baked and wear the curve of the tiles, which is precisely the bug this
  # guards. `read -t` gives the loop a heartbeat without a second process: on
  # timeout, re-read the one cheap thing that can change unannounced.
  #
  # Kept to a grep so the idle path costs one hyprctl and no jq. Measured at
  # 0.096 s CPU per 30 s idle on a laptop — 0.32%, the price of a lock screen
  # that is not announced. Two seconds is the trade: any longer and the artefact
  # is visible for that long on the way in. If Hyprland ever grows a
  # session-lock event, delete all of this and add it to the case above.
  # `|| true` is load-bearing twice over, because this file runs under `set -e`
  # (inherited from td-monitor): `grep -c` exits 1 when the count is ZERO, which
  # is the normal unlocked case, and a bare `read` that times out is a failing
  # command. Both killed the daemon on the first tick.
  lock_seen() { hyprctl monitors -j 2>/dev/null | grep -c '"LOCK"' || true; }
  locked_was="$(lock_seen)"
  socat -U - "UNIX-CONNECT:$sock" | while true; do
    rc=0
    read -r -t 2 line || rc=$?
    if ((rc != 0)); then
      # >128 is the timeout; anything else is EOF and the compositor is gone.
      # Captured into rc first: inside `if ! read ...` the `!` has already
      # rewritten $?, and the loop would spin instead of exiting.
      ((rc > 128)) || break
      locked_now="$(lock_seen)"
      if [[ "$locked_now" != "$locked_was" ]]; then
        locked_was="$locked_now"
        json="$(cap "$(tubes_json)")"
        if bake "$json"; then
          recompile >/dev/null
          echo "td-tubes: $(jq 'length' <<<"$json") tube(s)  <- session lock (polled; no event exists)"
        fi
      fi
      continue
    fi
    # A reload re-reads the config and drops both runtime preconditions, so
    # re-assert them there whether or not any tile actually moved.
    [[ "${line%%>>*}" == configreloaded ]] && precond_set
    case "${line%%>>*}" in
    openwindow | closewindow | movewindow | movewindowv2 | changefloatingmode | fullscreen | \
      workspace | workspacev2 | focusedmon | monitoradded | monitorremoved | activewindowv2 | \
      openlayer | closelayer | configreloaded)
      json="$(cap "$(tubes_json)")"
      if bake "$json"; then
        recompile >/dev/null
        echo "td-tubes: $(jq 'length' <<<"$json") tube(s)  <- ${line%%>>*}"
      fi
      ;;
    esac
  done
  ;;
-h | --help | help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//' ;;
*) die "unknown command '${1}' — td-tubes [list|apply|off|watch]" ;;
esac
