#!/usr/bin/env bash
# Tint THIS terminal — text and window border — without touching any other one.
#
#   td-tint              pick from the set
#   td-tint cherry       this terminal is now the cherry one
#   td-tint --clear      back to whatever the desktop theme says
#   td-tint --list       what is installed
#   td-tint --json       the same list as JSON (key/glyph/accent/partner)
#   td-tint --window 0x… cherry     aim at another terminal's window
#   td-tint --window 0x… --clear    …or clear it
#   td-tint --window 0x… --border-only cherry   borders only, leave the text palette be
#   td-tint --sync       reconcile EVERY terminal window: recorded picks get the
#                        current border rule, unrecorded fossils get reset
#
# Each painted window's pick is remembered at $XDG_RUNTIME_DIR/td-tint/<addr>
# — runtime-only like everything else here (dies at logout), but enough that a
# border repair restores an identity instead of guessing or erasing it.
#
# An Omarchy theme is global by design: switching it repaints every terminal
# at once, which is the opposite of being able to tell them apart. So this
# does not touch the theme. It writes the variant's OSC palette to this
# terminal's own tty, and sets the border colour as a property on this
# terminal's own window. Both are runtime-only — nothing is written to disk,
# nothing to clean up, and the tint dies with the window.
#
# Needs the variants installed (./install-variants.sh).
set -euo pipefail

THEMES="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/themes"
PREFIX="terminal-delight-"
CURRENT="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme/colors.toml"
RUNDIR="${XDG_RUNTIME_DIR:-/tmp}/td-tint"

die() { echo "td-tint: $*" >&2; exit 1; }

variants() {
  local d
  for d in "$THEMES/$PREFIX"*/; do
    [[ -d $d ]] || continue
    basename "$d" | sed "s/^$PREFIX//"
  done
}

glyph_of() {
  local g="$THEMES/$PREFIX$1/glyph"
  [[ -f $g ]] && tr -d '\n' <"$g" || printf '•'
}

# The tty to repaint: this shell's own terminal.
this_tty() {
  local t
  t=$(tty 2>/dev/null) && [[ $t == /dev/pts/* ]] && { echo "$t"; return; }
  t=$(readlink /proc/self/fd/1 2>/dev/null) || true
  [[ $t == /dev/pts/* ]] && echo "$t"
}

# The Hyprland window to recolour: the one whose process is an ancestor of
# this shell. Falls back to the focused window, which is the same thing when
# you are typing this yourself.
this_window() {
  command -v hyprctl >/dev/null || return 0
  hyprctl clients -j 2>/dev/null | python3 -c '
import json, os, sys

def ancestors(pid):
    seen = []
    while pid and pid > 1:
        seen.append(pid)
        try:
            with open(f"/proc/{pid}/status") as f:
                for line in f:
                    if line.startswith("PPid:"):
                        pid = int(line.split()[1])
                        break
                else:
                    break
        except OSError:
            break
    return seen

chain = ancestors(os.getppid())
owners = {c["pid"]: c["address"] for c in json.load(sys.stdin) if c.get("pid")}
for pid in chain:
    if pid in owners:
        print(owners[pid])
        break
' 2>/dev/null
}

# A dim of the same hue: scale each RGB channel to 35% so the unfocused
# border keeps the variant's identity at a fraction of its luminance. Alpha
# alone cannot do this — a neon accent at low alpha still reads bright over a
# dark tube, which is how "unfocused" ended up nearly as loud as "focused".
dim_hex() {
  local hex="${1#\#}" r g b
  r=$(( 16#${hex:0:2} * 35 / 100 ))
  g=$(( 16#${hex:2:2} * 35 / 100 ))
  b=$(( 16#${hex:4:2} * 35 / 100 ))
  printf '%02X%02X%02X' "$r" "$g" "$b"
}

# The CURRENT theme's border pair, computed from its palette exactly as the
# theme's own hyprland.lua computes it. Needed because set_prop has NO working
# "unset" on this build: the magic string is accepted and silently ignored
# (verified by pixel — a red override survives value="unset" untouched). The
# only reliable reset is an explicit SET to what the theme would have drawn.
theme_border_args() {
  local cur="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme/colors.toml"
  [[ -f $cur ]] || return 1
  local a b m
  a=$(omarchy-theme-color --file "$cur" accent)
  b=$(omarchy-theme-color --file "$cur" bright_cyan "$a")
  m=$(omarchy-theme-color --file "$cur" muted "$a")
  printf '%s\n%s\n' "rgba(${a#\#}ee) rgba(${b#\#}ee) 45deg" "rgba(${m#\#}55)"
}

# The border is the FOCUS signal: only the active window wears the loud 45°
# gradient; unfocused keeps the variant's hue as a quiet solid. Setting both
# states to the same bright value — the old behaviour — made a wall of tinted
# terminals read identity but never focus.
set_border() {
  local addr="$1" active="$2" inactive="$3"
  [[ -n $addr ]] || return 0
  hyprctl dispatch \
    "hl.dsp.window.set_prop({ prop = \"active_border_color\", value = \"$active\", window = \"address:$addr\" })" \
    >/dev/null 2>&1 || true
  hyprctl dispatch \
    "hl.dsp.window.set_prop({ prop = \"inactive_border_color\", value = \"$inactive\", window = \"address:$addr\" })" \
    >/dev/null 2>&1 || true
}

# Somebody ELSE'S terminal: --window hands us the Hyprland address, the client
# list maps it to the emulator's pid, and the shell inside is the first
# descendant holding a pts. Writing the OSC palette to that pts is the same
# trick as tinting yourself — the emulator interprets whatever arrives on its
# tty — just aimed. Two levels of children covers login-shell / wrapper setups.
window_pid() {
  hyprctl clients -j 2>/dev/null | jq -r --arg a "$1" '.[] | select(.address==$a) | .pid' | head -1
}

window_tty() {
  local pid child grand t
  pid="$(window_pid "$1")"
  [[ -n $pid && $pid != null ]] || return 1
  for child in $(ps --ppid "$pid" -o pid= 2>/dev/null); do
    t=$(ps -o tty= -p "$child" 2>/dev/null | tr -d ' ')
    [[ $t == pts/* ]] && { echo "/dev/$t"; return 0; }
  done
  for child in $(ps --ppid "$pid" -o pid= 2>/dev/null); do
    for grand in $(ps --ppid "$child" -o pid= 2>/dev/null); do
      t=$(ps -o tty= -p "$grand" 2>/dev/null | tr -d ' ')
      [[ $t == pts/* ]] && { echo "/dev/$t"; return 0; }
    done
  done
  return 1
}

# --window ADDR: aim every following action at that Hyprland window instead of
# the terminal this shell runs in.
TARGET_ADDR=""
if [[ "${1:-}" == "--window" ]]; then
  TARGET_ADDR="${2:?td-tint: --window needs a Hyprland address}"
  shift 2
fi

# --border-only: reframe the window without touching what's on the tube — the
# repair verb for a window whose text tint is right but whose border was lost.
BORDER_ONLY=""
if [[ "${1:-}" == "--border-only" ]]; then
  BORDER_ONLY=1
  shift
fi

case "${1:-}" in
--list)
  for v in $(variants); do printf '  %s  %s\n' "$(glyph_of "$v")" "$v"; done
  exit 0
  ;;
--sync)
  # The programmatic sweep: per-window border props survive theme reloads,
  # so any window painted under an OLD rule keeps reading wrong until
  # someone reconciles it. This makes reconciliation one idempotent verb:
  # a recorded pick is re-framed under the CURRENT rule; a window with no
  # record can only be bright by accident, so its props reset to the theme;
  # records for windows that no longer exist are swept.
  command -v hyprctl >/dev/null || die "hyprctl not found"
  mkdir -p "$RUNDIR"
  clients="$(hyprctl clients -j)"
  mapfile -t THEME_TB < <(theme_border_args) || true
  count=0
  while IFS= read -r addr; do
    [[ -n $addr ]] || continue
    rec="$RUNDIR/$addr"
    if [[ -f $rec ]]; then
      v="$(head -1 "$rec")"
      c="$THEMES/$PREFIX$v/colors.toml"
      if [[ -f $c ]]; then
        a=$(omarchy-theme-color --file "$c" accent)
        b=$(omarchy-theme-color --file "$c" bright_cyan "$a")
        set_border "$addr" "rgba(${a#\#}ee) rgba(${b#\#}ee) 45deg" "rgba($(dim_hex "$a")cc)"
      else
        rm -f "$rec"
      fi
    else
      # an unrecorded window can only carry junk props by accident — pin it
      # to exactly what the theme would draw (set_prop "unset" is a no-op)
      [[ ${#THEME_TB[@]} -eq 2 ]] && set_border "$addr" "${THEME_TB[0]}" "${THEME_TB[1]}"
    fi
    count=$((count + 1))
  done < <(jq -r '.[] | select(.class=="foot" or .class=="Alacritty" or .class=="kitty" or .class=="com.mitchellh.ghostty" or .class=="org.wezfurlong.wezterm") | .address' <<<"$clients")
  alive="$(jq -r '.[].address' <<<"$clients")"
  for f in "$RUNDIR"/0x*; do
    [[ -e $f ]] || break
    grep -qx "$(basename "$f")" <<<"$alive" || rm -f "$f"
  done
  echo "synced $count terminal window(s): recorded picks re-framed, fossils reset"
  exit 0
  ;;
--json)
  # The overlay's contract: every installed variant with the two colours a
  # card needs. Plain ordered JSON, no jq required to produce or consume.
  printf '['
  first=1
  for v in $(variants); do
    c="$THEMES/$PREFIX$v/colors.toml"
    a=$(omarchy-theme-color --file "$c" accent)
    b=$(omarchy-theme-color --file "$c" bright_cyan "$a")
    [[ $first -eq 1 ]] || printf ','
    printf '{"key":"%s","glyph":"%s","accent":"%s","partner":"%s"}' \
      "$v" "$(glyph_of "$v")" "$a" "$b"
    first=0
  done
  printf ']\n'
  exit 0
  ;;
--clear)
  if [[ -n $TARGET_ADDR ]]; then
    tty=$(window_tty "$TARGET_ADDR") || die "no shell tty behind window $TARGET_ADDR"
    addr="$TARGET_ADDR"
  else
    tty=$(this_tty) || true
    addr=$(this_window) || true
  fi
  [[ -n ${tty:-} && -f $CURRENT ]] && omarchy-theme-osc "$CURRENT" >"$tty"
  if [[ -n ${addr:-} ]]; then
    if mapfile -t tb < <(theme_border_args) && [[ ${#tb[@]} -eq 2 ]]; then
      set_border "$addr" "${tb[0]}" "${tb[1]}"
    fi
    rm -f "$RUNDIR/$addr"
  fi
  echo "cleared — this terminal follows the desktop theme again."
  exit 0
  ;;
esac

variant="${1:-}"

if [[ -z $variant ]]; then
  # Window mode is scriptable, not interactive — the picker is the overlay.
  [[ -z $TARGET_ADDR ]] || die "--window needs an explicit variant (or --clear)"
  command -v gum >/dev/null || die "give a variant, or install gum for the picker. td-tint --list"
  variant=$(for v in $(variants); do printf '%s %s\n' "$(glyph_of "$v")" "$v"; done |
    gum filter --placeholder="which terminal is this?" --height=12) || exit 0
  variant=${variant##* }
fi

theme="$THEMES/$PREFIX$variant"
[[ -d $theme ]] || die "no variant '$variant'. Try: td-tint --list"
colors="$theme/colors.toml"
[[ -f $colors ]] || die "$colors is missing — re-run ./install-variants.sh"

# 1. the text: the target terminal's own palette, straight down its tty
# (skipped under --border-only — the tube already shows the right colours)
if [[ -z $BORDER_ONLY ]]; then
  if [[ -n $TARGET_ADDR ]]; then
    tty=$(window_tty "$TARGET_ADDR") || die "no shell tty behind window $TARGET_ADDR"
  else
    tty=$(this_tty) || true
    [[ -n ${tty:-} ]] || die "not attached to a terminal."
  fi
  omarchy-theme-osc "$colors" >"$tty"
fi

# 2. the frame: this window's own border, so it reads while unfocused too
accent=$(omarchy-theme-color --file "$colors" accent)
partner=$(omarchy-theme-color --file "$colors" bright_cyan "$accent")
if [[ -n $TARGET_ADDR ]]; then addr="$TARGET_ADDR"; else addr=$(this_window) || true; fi
set_border "${addr:-}" "rgba(${accent#\#}ee) rgba(${partner#\#}ee) 45deg" "rgba($(dim_hex "$accent")cc)"

# remember the pick, so a later repair restores instead of guessing
if [[ -n ${addr:-} ]]; then
  mkdir -p "$RUNDIR"
  printf '%s\n' "$variant" >"$RUNDIR/$addr"
fi

printf '%s  this terminal is %s\n' "$(glyph_of "$variant")" "$variant"
